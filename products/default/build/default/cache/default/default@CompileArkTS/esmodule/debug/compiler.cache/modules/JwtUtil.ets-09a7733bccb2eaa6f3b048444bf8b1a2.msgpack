      const codePoint: number = ((b0 & 0x07) << 18) | ((b1 & 0x3f) << 12) | ((b2 & 0x3f) << 6) | (b3 & 0x3f);
      const offset: number = codePoint - 0x10000;
      const lead: number = 0xd800 + ((offset >> 10) & 0x3ff);
