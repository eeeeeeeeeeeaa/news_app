                 MinePage({
                   userInfo: this.currentUser,
                   loginStatus: this.isLoggedIn,
                   onLogout: async () => {
                     console.log('ðŸ”„ MinePage.onLogout è¢«è°ƒç”¨');
                     await this.checkLoginStatus();
                   }
                 })
               }
              .padding({ left: 12, right: 12 })
              .backgroundColor('#F5F5F5')
              .tabBar(this.TabBuilder($r('app.string.tab_mine'), 3))
            }
            .margin({ bottom: 64 })
            .width('100%')
            .height('100%')
            .barHeight(80)
            .barMode(BarMode.Fixed)
            .onChange((index: number) => {
              this.currentTabIndex = index;
            })
          }
          .width('100%')
          .height('100%')
          .backgroundColor('#F5F5F5')
        }
        .width('100%')
        .height('100%')
      } else {
        // ç”¨æˆ·æœªç™»å½•ï¼Œæ˜¾ç¤ºç™»å½•é¡µé¢
        Column() {
          LoginPage({
            onLoginSuccess: () => {
              console.log('ðŸŽ‰ LoginPage.onLoginSuccess å›žè°ƒè¢«è°ƒç”¨');
              this.handleLoginSuccess();
            }
          })

          // è°ƒè¯•æŒ‰é’®
          Button('æ‰‹åŠ¨æ£€æŸ¥ç™»å½•çŠ¶æ€')
            .margin({ top: 20 })
            .width('80%')
            .height(40)
            .backgroundColor('#E60012')
            .fontColor('#FFFFFF')
            .onClick(async () => {
              console.log('ðŸ§ª æ‰‹åŠ¨æµ‹è¯•æ£€æŸ¥ç™»å½•çŠ¶æ€');
              await this.checkLoginStatus();
            })

          Button('å¼ºåˆ¶è®¾ç½®ä¸ºå·²ç™»å½•')
            .margin({ top: 10 })
            .width('80%')
            .height(40)
            .backgroundColor('#007DFF')
            .fontColor('#FFFFFF')
            .onClick(() => {
              console.log('ðŸ§ª å¼ºåˆ¶è®¾ç½®ä¸ºå·²ç™»å½•');
              this.setLoggedIn(true);
            })

          Button('å¼ºåˆ¶è®¾ç½®ä¸ºæœªç™»å½•')
            .margin({ top: 10 })
            .width('80%')
            .height(40)
            .backgroundColor('#FF6B35')
            .fontColor('#FFFFFF')
            .onClick(() => {
              console.log('ðŸ§ª å¼ºåˆ¶è®¾ç½®ä¸ºæœªç™»å½•');
              this.setLoggedIn(false);
            })
        }
        .width('100%')
        .height('100%')
        .justifyContent(FlexAlign.Center)
      }
    }
    .width('100%')
    .height('100%')
  }
