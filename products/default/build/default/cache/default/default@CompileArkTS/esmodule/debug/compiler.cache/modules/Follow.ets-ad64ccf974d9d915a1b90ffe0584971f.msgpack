import { BaiduHotSearchParser } from 'utils';
import webview from '@ohos.web.webview';
import { NewsFollowService, type FollowedNewsItem } from './NewsFollowService';

/**
 * å…³æ³¨æ–°é—»æ•°æ®æ¥å£
 */
export interface FollowedNewsData {
  id: string;
  title: string;
  publishTime: string;
  publisher: string;
  imageUrl?: string;
  content?: string;
}

/**
 * æ–°é—»å¡ç‰‡ç»„ä»¶
 * æ˜¾ç¤ºæ–°é—»æ ‡é¢˜ã€å‘å¸ƒæ—¶é—´ã€å‘å¸ƒè€…ç­‰ä¿¡æ¯
 */
@Component
export struct NewsCard {
  @Prop newsData: FollowedNewsData;
  onCardClick?: (newsData: FollowedNewsData) => void;
  onUnfollow?: () => void;

  build() {
    Column() {
      // æ–°é—»æ ‡é¢˜
      Text(this.newsData.title)
        .fontSize(16)
        .fontWeight(FontWeight.Medium)
        .fontColor('#182431')
        .maxLines(2)
        .textOverflow({ overflow: TextOverflow.Ellipsis })
        .width('100%')
        .margin({ bottom: 8 })

      // åº•éƒ¨ä¿¡æ¯è¡Œ
      Row() {
        // å‘å¸ƒè€…
        Text(this.newsData.publisher)
          .fontSize(12)
          .fontColor('#666666')
          .backgroundColor('#F5F5F5')
          .padding({ left: 8, right: 8, top: 4, bottom: 4 })
          .borderRadius(4)

        Blank()

        // å–æ¶ˆå…³æ³¨æŒ‰é’®
        if (this.onUnfollow) {
          Text('å–æ¶ˆå…³æ³¨')
            .fontSize(12)
            .fontColor('#E60012')
            .backgroundColor('#FFF5F5')
            .padding({ left: 8, right: 8, top: 4, bottom: 4 })
            .borderRadius(4)
            .margin({ right: 8 })
            .onClick(() => {
              if (this.onUnfollow) {
                this.onUnfollow();
              }
            })
        }

        // å‘å¸ƒæ—¶é—´
        Text(this.formatTime(this.newsData.publishTime))
          .fontSize(12)
          .fontColor('#999999')
      }
      .width('100%')
      .alignItems(VerticalAlign.Center)
    }
    .width('100%')
    .padding(16)
    .backgroundColor('#FFFFFF')
    .borderRadius(8)
    .shadow({
      radius: 4,
      color: '#1A000000',
      offsetX: 0,
      offsetY: 2
    })
    .onClick(() => {
      if (this.onCardClick) {
        this.onCardClick(this.newsData);
      }
    })
  }

  /**
   * æ ¼å¼åŒ–æ—¶é—´æ˜¾ç¤º
   * @param timeStr æ—¶é—´å­—ç¬¦ä¸²
   * @returns æ ¼å¼åŒ–åçš„æ—¶é—´
   */
  private formatTime(timeStr: string): string {
    try {
      const date = new Date(timeStr);
      const now = new Date();
      const diff = now.getTime() - date.getTime();
      
      // è®¡ç®—æ—¶é—´å·®
      const minutes = Math.floor(diff / (1000 * 60));
      const hours = Math.floor(diff / (1000 * 60 * 60));
      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      
      if (minutes < 60) {
        return `${minutes}åˆ†é’Ÿå‰`;
      } else if (hours < 24) {
        return `${hours}å°æ—¶å‰`;
      } else if (days < 7) {
        return `${days}å¤©å‰`;
      } else {
        // è¶…è¿‡7å¤©æ˜¾ç¤ºå…·ä½“æ—¥æœŸ
        return `${date.getMonth() + 1}æœˆ${date.getDate()}æ—¥`;
      }
    } catch (error) {
      return timeStr;
    }
  }
}

// ets/view/Follow.ets
@Component
export default struct FollowPage {
  @State searchText: string = '';
  @State selectedUrl: string | null = null;
  private webController: webview.WebviewController = new webview.WebviewController();
  @State hotTitles: string[] = [];
  @State followedNewsList: FollowedNewsItem[] = [];
  @State isLoading: boolean = true; // æ ‡è®°æ˜¯å¦æ­£åœ¨åŠ è½½
  @State errorMessage: string = ''; // é”™è¯¯ä¿¡æ¯
  private newsFollowService: NewsFollowService = NewsFollowService.getInstance();

  async aboutToAppear() {
    try {
      const realtime = await BaiduHotSearchParser.getHotSearchData('realtime');
      this.hotTitles = realtime.slice(0, 10).map((it) => it.card_title);
    } catch (_) {
      this.hotTitles = [];
    }
    
    // åŠ è½½å…³æ³¨çš„æ–°é—»æ•°æ®
    await this.loadFollowedNewsList();
  }

  /**
   * åŠ è½½å…³æ³¨çš„æ–°é—»åˆ—è¡¨
   */
  private async loadFollowedNewsList(): Promise<void> {
    this.isLoading = true;
    this.errorMessage = '';
    
    try {
      const followedNews = await this.newsFollowService.getFollowedNewsList();
      this.followedNewsList = followedNews;
      this.isLoading = false;
      console.log('âœ… æˆåŠŸåŠ è½½å…³æ³¨åˆ—è¡¨ï¼Œå…±', followedNews.length, 'æ¡æ•°æ®');
    } catch (error) {
      console.error('âŒ åŠ è½½å…³æ³¨åˆ—è¡¨å¤±è´¥:', error);
      this.followedNewsList = [];
      this.isLoading = false;
      
      if (error instanceof Error) {
        this.errorMessage = error.message;
      } else {
        this.errorMessage = 'åŠ è½½å¤±è´¥ï¼Œè¯·ç¨åå†è¯•';
      }
    }
  }

  private openBrowser(url: string): void {
    this.selectedUrl = url;
  }

  private closeBrowser(): void {
    this.selectedUrl = null;
  }

  /**
   * ç‚¹å‡»æ–°é—»å¡ç‰‡ï¼Œæ‰“å¼€æ–°é—»è¯¦æƒ…
   * @param newsData æ–°é—»æ•°æ®
   */
  private onNewsCardClick(newsData: FollowedNewsItem): void {
    console.log('ç‚¹å‡»æ–°é—»å¡ç‰‡:', newsData.newsTitle);
    console.log('æ–°é—»URL:', newsData.newsUniquekey);
    
    // newsUniquekey å®é™…å­˜æ”¾çš„æ˜¯æ–°é—»çš„ URL
    if (newsData.newsUniquekey && newsData.newsUniquekey.trim().length > 0) {
      this.openBrowser(newsData.newsUniquekey);
    } else {
      console.warn('æ–°é—»URLä¸ºç©ºï¼Œæ— æ³•æ‰“å¼€è¯¦æƒ…');
    }
  }

  /**
   * å–æ¶ˆå…³æ³¨æ–°é—»
   * @param newsData æ–°é—»æ•°æ®
   */
  private async onUnfollowNews(newsData: FollowedNewsItem): Promise<void> {
    try {
      const success = await this.newsFollowService.unfollowNews(newsData.newsUniquekey);
      if (success) {
        // ä»åˆ—è¡¨ä¸­ç§»é™¤è¯¥æ–°é—»
        this.followedNewsList = this.followedNewsList.filter(item => item.followId !== newsData.followId);
      }
    } catch (error) {
      console.error('å–æ¶ˆå…³æ³¨å¤±è´¥:', error);
    }
  }

  @Builder
  buildBrowserLayer(url: string) {
    Column() {
      Row() {
        Text('å…³é—­')
          .fontSize(16)
          .fontColor('#E60012')
          .padding({ left: 16, right: 16, top: 16, bottom: 16 })
          .onClick(() => {
            this.closeBrowser();
          })

        Blank()

        Text('æ–°é—»è¯¦æƒ…')
          .fontSize(16)
          .fontWeight(FontWeight.Medium)
          .fontColor('#182431')
          .margin({ right: 24 })
      }
      .width('100%')
      .backgroundColor('#FFFFFF')

      Web({ src: url, controller: this.webController })
        .layoutWeight(1)
        .width('100%')
    }
    .padding({ top: '48vp' })
    .width('100%')
    .height('100%')
    .backgroundColor('#FFFFFF')
  }

  build() {
    Stack({ alignContent: Alignment.TopStart }) {
      Column() {
        // é¡¶éƒ¨æœç´¢æ¡†ï¼ˆå…¬å…±ç»„ä»¶ï¼‰
        CommonSearchBar({
          value: this.searchText,
          placeholder: 'æœç´¢æ–°é—»',
          hotTitles: this.hotTitles,
          onSearch: (url: string) => {
            this.openBrowser(url);
          }
        })
        .padding({ left: '12vp', right: '12vp', top: '8vp', bottom: '8vp' })

        // é¡µé¢æ ‡é¢˜å’Œåˆ·æ–°æŒ‰é’®
        Row() {
          Text('æˆ‘çš„å…³æ³¨')
            .fontSize(20)
            .fontWeight(FontWeight.Bold)
            .fontColor('#182431')
          
          Blank()
          
          // åˆ·æ–°æŒ‰é’®
          Text('åˆ·æ–°')
            .fontSize(12)
            .fontColor('#1890FF')
            .backgroundColor('#F0F9FF')
            .padding({ left: 8, right: 8, top: 4, bottom: 4 })
            .borderRadius(4)
            .onClick(() => {
              this.loadFollowedNewsList();
            })
        }
        .width('100%')
        .margin({ left: 16, right: 16, top: 16, bottom: 16 })

        // å†…å®¹åŒºåŸŸ
        if (this.isLoading) {
          // åŠ è½½çŠ¶æ€
          Column() {
            LoadingProgress()
              .width(40)
              .height(40)
              .margin({ bottom: 16 })
            
            Text('æ­£åœ¨åŠ è½½...')
              .fontSize(16)
              .fontColor('#999999')
          }
          .layoutWeight(1)
          .justifyContent(FlexAlign.Center)
          .alignItems(HorizontalAlign.Center)
        } else if (this.errorMessage) {
          // é”™è¯¯çŠ¶æ€
          Column() {
            Text('âš ï¸')
              .fontSize(48)
              .margin({ bottom: 16 })
            
            Text('åŠ è½½å¤±è´¥')
              .fontSize(18)
              .fontWeight(FontWeight.Medium)
              .fontColor('#FF4D4F')
              .margin({ bottom: 8 })
            
            Text(this.errorMessage)
              .fontSize(14)
              .fontColor('#999999')
              .textAlign(TextAlign.Center)
              .margin({ bottom: 16 })
            
            Text('ç‚¹å‡»åˆ·æ–°é‡è¯•')
              .fontSize(12)
              .fontColor('#1890FF')
              .onClick(() => {
                this.loadFollowedNewsList();
              })
          }
          .layoutWeight(1)
          .justifyContent(FlexAlign.Center)
          .alignItems(HorizontalAlign.Center)
        } else if (this.followedNewsList.length > 0) {
          // æœ‰æ•°æ®çŠ¶æ€
          List() {
            ForEach(this.followedNewsList, (newsItem: FollowedNewsItem, index: number) => {
              ListItem() {
                NewsCard({
                  newsData: {
                    id: newsItem.newsUniquekey,
                    title: newsItem.newsTitle,
                    publishTime: newsItem.newsTime || '',
                    publisher: newsItem.newsAuthor || '',
                    imageUrl: undefined,
                    content: undefined
                  },
                  onCardClick: (newsData: FollowedNewsData) => {
                    this.onNewsCardClick(newsItem);
                  },
                  onUnfollow: () => {
                    this.onUnfollowNews(newsItem);
                  }
                })
                .margin({ left: 16, right: 16, bottom: 12 })
              }
            }, (newsItem: FollowedNewsItem, index: number) => `${newsItem.followId}-${index}`)
          }
          .layoutWeight(1)
          .width('100%')
          .backgroundColor('#F8F9FA')
        } else {
          // ç©ºçŠ¶æ€ï¼ˆæ²¡æœ‰å…³æ³¨ä»»ä½•æ–°é—»ï¼‰
          Column() {
            Text('ğŸ“°')
              .fontSize(48)
              .margin({ bottom: 16 })
            
            Text('æš‚æ— å…³æ³¨çš„æ–°é—»')
              .fontSize(18)
              .fontWeight(FontWeight.Medium)
              .fontColor('#999999')
              .margin({ bottom: 8 })
            
            Text('å»å…³æ³¨ä¸€äº›æ„Ÿå…´è¶£çš„æ–°é—»å§')
              .fontSize(14)
              .fontColor('#CCCCCC')
          }
          .layoutWeight(1)
          .justifyContent(FlexAlign.Center)
          .alignItems(HorizontalAlign.Center)
        }
      }
      .padding({ top: '48vp' })
      .width('100%')
      .height('100%')
      .backgroundColor('#F8F9FA')

      if (this.selectedUrl !== null) {
        this.buildBrowserLayer(this.selectedUrl as string);
      }
    }
    .width('100%')
    .height('100%')
  }
}
