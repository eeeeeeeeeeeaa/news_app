    const isExpired = await this.jwtManager.isTokenExpired();
    
    if (isExpired === true) {
      await this.jwtManager.removeToken();
      console.log('AuthHelper: å·²æ¸…ç†è¿‡æœŸ Token');
      return true;
    }
    
    return false;
  }
}

