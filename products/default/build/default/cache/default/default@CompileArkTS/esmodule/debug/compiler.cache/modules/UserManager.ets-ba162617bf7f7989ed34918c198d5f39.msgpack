      if (!token) {
        return false;
      }

      // æ£€æŸ¥æ ¼å¼å’Œè¿‡æœŸæ—¶é—´
      return JwtUtil.isValidFormat(token) && !JwtUtil.isTokenExpired(token);
    } catch (error) {
      console.error('JWTéªŒè¯å¤±è´¥:', error);
      return false;
    }
  }

  // è·å–JWTå‰©ä½™æœ‰æ•ˆæ—¶é—´ï¼ˆç§’ï¼‰
  public async getTokenRemainingTime(): Promise<number> {
    try {
      const token = await this.getToken();
      if (!token) {
        return -1;
      }

      return JwtUtil.getRemainingTime(token);
    } catch (error) {
      console.error('è·å–JWTå‰©ä½™æ—¶é—´å¤±è´¥:', error);
      return -1;
    }
  }
