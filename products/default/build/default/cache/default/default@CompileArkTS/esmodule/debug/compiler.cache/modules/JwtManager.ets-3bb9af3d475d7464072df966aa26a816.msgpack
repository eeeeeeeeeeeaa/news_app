   * @returns è§£ç åçš„å­—ç¬¦ä¸²
   */
  private base64UrlDecode(base64Url: string): string {
    try {
      // Base64 URL ä½¿ç”¨ - å’Œ _ æ›¿æ¢äº† + å’Œ /
      let base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');

      // è¡¥é½ padding
      const padding = base64.length % 4;
      if (padding > 0) {
        base64 += '='.repeat(4 - padding);
      }

      // ä½¿ç”¨ util.Base64Helper è¿›è¡Œè§£ç 
      const decoder = new util.Base64Helper();
      const uint8Array = decoder.decodeSync(base64);

      // å°† Uint8Array è½¬æ¢ä¸ºå­—ç¬¦ä¸²
      const textDecoder = util.TextDecoder.create('utf-8', { ignoreBOM: true });
      const decodedStr = textDecoder.decodeWithStream(uint8Array, { stream: false });

      return decodedStr;
    } catch (err) {
      const errorMessage = err instanceof Error ? err.message : 'Base64 è§£ç å¤±è´¥';
      console.error('JwtManager: Base64 è§£ç å¤±è´¥:', err);
      throw new Error(`JWT Base64 è§£ç å¤±è´¥: ${errorMessage}`);
    }
  }

  /**
   * è·å– JWT Token çš„ Payload
   * @returns Payload å¯¹è±¡ï¼Œä¸å­˜åœ¨æˆ–è§£æå¤±è´¥è¿”å› null
   */
  public async getPayload(): Promise<JwtPayload | null> {
    // ä¼˜å…ˆè¿”å›ç¼“å­˜
    if (this.cachedPayload) {
      return this.cachedPayload;
    }

    const token = await this.getToken();
    if (!token) {
      return null;
    }

    const payload = this.parseJwtPayload(token);
    if (Object.keys(payload).length === 0) {
      return null;
    }

    this.cachedPayload = payload;
    return payload;
  }

  /**
   * æ£€æŸ¥ Token æ˜¯å¦è¿‡æœŸ
   * @returns true è¡¨ç¤ºå·²è¿‡æœŸï¼Œfalse è¡¨ç¤ºæœªè¿‡æœŸï¼Œnull è¡¨ç¤ºæ— æ³•åˆ¤æ–­
   */
  public async isTokenExpired(): Promise<boolean | null> {
    const payload = await this.getPayload();
    if (!payload || !payload.exp) {
      console.warn('JwtManager: æ— æ³•è·å– token è¿‡æœŸæ—¶é—´');
      return null;
    }

    // exp æ˜¯ç§’çº§æ—¶é—´æˆ³ï¼Œéœ€è¦è½¬æ¢ä¸ºæ¯«ç§’
    const expirationTime = payload.exp * 1000;
    const currentTime = Date.now();

    const isExpired = currentTime >= expirationTime;
    console.log(`JwtManager: Token ${isExpired ? 'å·²è¿‡æœŸ' : 'æœªè¿‡æœŸ'}`);

    return isExpired;
  }

  /**
   * æ£€æŸ¥ Token æ˜¯å¦æœ‰æ•ˆï¼ˆå­˜åœ¨ä¸”æœªè¿‡æœŸï¼‰
   * @returns true è¡¨ç¤ºæœ‰æ•ˆï¼Œfalse è¡¨ç¤ºæ— æ•ˆ
   */
  public async isTokenValid(): Promise<boolean> {
    const token = await this.getToken();
    if (!token) {
      console.log('JwtManager: Token ä¸å­˜åœ¨');
      return false;
    }

    const isExpired = await this.isTokenExpired();
    if (isExpired === null) {
      // æ— æ³•åˆ¤æ–­è¿‡æœŸæ—¶é—´ï¼Œè®¤ä¸º token æ— æ•ˆ
      console.warn('JwtManager: æ— æ³•åˆ¤æ–­ token æœ‰æ•ˆæ€§');
      return false;
    }

    const isValid = !isExpired;
    console.log(`JwtManager: Token ${isValid ? 'æœ‰æ•ˆ' : 'æ— æ•ˆ'}`);
    return isValid;
  }

  /**
   * è·å– Token è¿‡æœŸæ—¶é—´
   * @returns Date å¯¹è±¡ï¼Œä¸å­˜åœ¨è¿”å› null
   */
  public async getExpirationDate(): Promise<Date | null> {
    const payload = await this.getPayload();
    if (!payload || !payload.exp) {
      return null;
    }

    // exp æ˜¯ç§’çº§æ—¶é—´æˆ³ï¼Œéœ€è¦è½¬æ¢ä¸ºæ¯«ç§’
    return new Date(payload.exp * 1000);
  }

  /**
   * è·å– Token å‰©ä½™æœ‰æ•ˆæ—¶é—´ï¼ˆæ¯«ç§’ï¼‰
   * @returns å‰©ä½™æ—¶é—´ï¼ˆæ¯«ç§’ï¼‰ï¼Œå·²è¿‡æœŸè¿”å› 0ï¼Œæ— æ³•åˆ¤æ–­è¿”å› null
   */
  public async getTimeToExpiration(): Promise<number | null> {
    const expirationDate = await this.getExpirationDate();
    if (!expirationDate) {
      return null;
    }

    const remainingTime = expirationDate.getTime() - Date.now();
    return remainingTime > 0 ? remainingTime : 0;
  }

  /**
   * è·å–å®Œæ•´çš„ Token ä¿¡æ¯
   * @returns JwtTokenInfo å¯¹è±¡ï¼Œä¸å­˜åœ¨è¿”å› null
   */
  public async getTokenInfo(): Promise<JwtTokenInfo | null> {
    const token = await this.getToken();
    if (!token) {
      return null;
    }

    const payload = await this.getPayload();
    if (!payload) {
      return null;
    }

    const isExpired = await this.isTokenExpired();
    const expirationDate = await this.getExpirationDate();

    const tokenInfo: JwtTokenInfo = {
      token: token,
      payload: payload,
      isValid: isExpired === false,
      isExpired: isExpired === true,
      expirationDate: expirationDate
    };

    return tokenInfo;
  }

  /**
   * è·å–è®¤è¯è¯·æ±‚å¤´
   * @returns åŒ…å« Authorization çš„è¯·æ±‚å¤´å¯¹è±¡
   */
  public async getAuthHeaders(): Promise<Record<string, string>> {
    const token = await this.getToken();
    const headers: Record<string, string> = {};

    if (token) {
      headers['Authorization'] = `Bearer ${token}`;
    }

    return headers;
  }

  /**
   * ä» Payload ä¸­è·å–ç”¨æˆ·ä¿¡æ¯
   * @returns ç”¨æˆ·ä¿¡æ¯å¯¹è±¡ï¼Œä¸å­˜åœ¨è¿”å› null
   */
  public async getUserInfoFromToken(): Promise<UserTokenInfo | null> {
    const payload = await this.getPayload();
    if (!payload) {
      return null;
    }

    return {
      userId: payload.userId,
      userPhone: payload.userPhone,
      userName: payload.userName
    };
  }

  /**
   * æ¸…é™¤æ‰€æœ‰ç¼“å­˜
   */
  public clearCache(): void {
    this.cachedToken = null;
    this.cachedPayload = null;
    console.log('JwtManager: ç¼“å­˜å·²æ¸…é™¤');
  }
}

