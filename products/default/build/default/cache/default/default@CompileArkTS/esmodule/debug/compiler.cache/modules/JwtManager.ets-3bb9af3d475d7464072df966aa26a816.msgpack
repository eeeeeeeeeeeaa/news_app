    console.log('ğŸ” [JwtManager.getToken] dataPreferences å­˜åœ¨:', !!this.dataPreferences);
    if (!this.dataPreferences) {
      console.log('ğŸ” [JwtManager.getToken] Preferences æœªåˆå§‹åŒ–ï¼Œå¼€å§‹åˆå§‹åŒ–...');
      await this.initPreferences();
