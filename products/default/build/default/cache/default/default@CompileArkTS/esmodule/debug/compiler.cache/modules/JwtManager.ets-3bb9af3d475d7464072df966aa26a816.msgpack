  public async saveToken(token: string): Promise<boolean> {
    console.log('ğŸ” [JwtManager.saveToken] å¼€å§‹ä¿å­˜ Token...');
    console.log('ğŸ” [JwtManager.saveToken] Token ç±»å‹:', typeof token);
    console.log('ğŸ” [JwtManager.saveToken] Token æ˜¯å¦ä¸ºç©º:', !token);
    
    if (!token || typeof token !== 'string' || token.trim() === '') {
      console.error('âŒ [JwtManager.saveToken] æ— æ•ˆçš„ token');
      return false;
    }
    
    console.log('ğŸ” [JwtManager.saveToken] Token é•¿åº¦:', token.length);
    console.log('ğŸ” [JwtManager.saveToken] dataPreferences å­˜åœ¨:', !!this.dataPreferences);

    if (!this.dataPreferences) {
      console.log('ğŸ” [JwtManager.saveToken] Preferences æœªåˆå§‹åŒ–ï¼Œå¼€å§‹åˆå§‹åŒ–...');
      await this.initPreferences();
    }

    try {
      console.log('ğŸ” [JwtManager.saveToken] å¼€å§‹å†™å…¥ Token åˆ° Preferences...');
      console.log('ğŸ” [JwtManager.saveToken] å­˜å‚¨é”®:', this.JWT_TOKEN_KEY);
      
      // å­˜å‚¨ token
      await this.dataPreferences?.put(this.JWT_TOKEN_KEY, token);
      console.log('âœ… [JwtManager.saveToken] Token å·²å†™å…¥');
      
      // å­˜å‚¨åˆ·æ–°æ—¶é—´
      await this.dataPreferences?.put(this.TOKEN_REFRESH_TIME_KEY, Date.now());
      console.log('âœ… [JwtManager.saveToken] åˆ·æ–°æ—¶é—´å·²å†™å…¥');
      
      // æŒä¹…åŒ–
      await this.dataPreferences?.flush();
      console.log('âœ… [JwtManager.saveToken] flush å®Œæˆ');

      // æ›´æ–°ç¼“å­˜
      this.cachedToken = token;
      this.cachedPayload = this.parseJwtPayload(token);
      console.log('âœ… [JwtManager.saveToken] ç¼“å­˜å·²æ›´æ–°');

      console.log('âœ… [JwtManager.saveToken] Token å­˜å‚¨æˆåŠŸ');
      return true;
    } catch (err) {
      console.error('âŒ [JwtManager.saveToken] å­˜å‚¨ token å¤±è´¥:', err);
      if (err instanceof Error) {
        console.error('âŒ [JwtManager.saveToken] é”™è¯¯æ¶ˆæ¯:', err.message);
        console.error('âŒ [JwtManager.saveToken] é”™è¯¯å †æ ˆ:', err.stack);
