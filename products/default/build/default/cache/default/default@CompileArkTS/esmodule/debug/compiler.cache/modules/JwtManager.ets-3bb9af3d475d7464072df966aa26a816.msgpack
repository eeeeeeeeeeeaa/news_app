      console.log('ğŸ” [JwtManager.getToken] å­˜å‚¨é”®:', this.JWT_TOKEN_KEY);
      
      const token = await this.dataPreferences?.get(this.JWT_TOKEN_KEY, '');
      console.log('ğŸ” [JwtManager.getToken] è¯»å–ç»“æœç±»å‹:', typeof token);
      console.log('ğŸ” [JwtManager.getToken] è¯»å–ç»“æœé•¿åº¦:', typeof token === 'string' ? token.length : 0);
      
      if (token && typeof token === 'string' && token !== '') {
        this.cachedToken = token;
        console.log('âœ… [JwtManager.getToken] Token è·å–æˆåŠŸå¹¶æ›´æ–°ç¼“å­˜');
        return token;
