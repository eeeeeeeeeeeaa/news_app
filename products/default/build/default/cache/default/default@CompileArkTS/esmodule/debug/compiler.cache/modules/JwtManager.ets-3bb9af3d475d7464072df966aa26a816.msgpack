    console.log('ğŸ” [JwtManager.getToken] ç¼“å­˜çš„ Token:', this.cachedToken ? 'å­˜åœ¨' : 'null');
    
    // ä¼˜å…ˆè¿”å›ç¼“å­˜
    if (this.cachedToken) {
      console.log('âœ… [JwtManager.getToken] ä»ç¼“å­˜è¿”å› Tokenï¼Œé•¿åº¦:', this.cachedToken.length);
      return this.cachedToken;
