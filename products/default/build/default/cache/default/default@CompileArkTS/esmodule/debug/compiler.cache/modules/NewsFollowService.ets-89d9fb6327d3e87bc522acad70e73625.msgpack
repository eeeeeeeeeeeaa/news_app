  /**
   * æµ‹è¯•tokenæœ‰æ•ˆæ€§ï¼ˆé€šè¿‡è°ƒç”¨ç”¨æˆ·ä¿¡æ¯æ¥å£ï¼‰
   * @returns Promise<boolean> tokenæ˜¯å¦æœ‰æ•ˆ
   */
  private async testTokenValidity(): Promise<boolean> {
    try {
      const token: string | null = await this.userManager.getToken();
      if (!token) {
        return false;
      }

      const authToken = token.startsWith('Bearer ') ? token : `Bearer ${token}`;
      const headers: Record<string, string> = {
        'Authorization': authToken
      };

      const url: string = withBase('/api/users/info');
      console.log('ğŸ§ª æµ‹è¯•tokenæœ‰æ•ˆæ€§ï¼Œè¯·æ±‚URL:', url);
      
      const respText: string = await HttpUtils.get(url, headers);
      const resp: ResultShape<object> = JSON.parse(respText) as ResultShape<object>;
      
      console.log('ğŸ§ª tokenéªŒè¯ç»“æœ:', resp);
      return resp.code === 200;
    } catch (err) {
      console.error('ğŸ§ª tokenéªŒè¯å¤±è´¥:', err);
      return false;
    }
  }

  /**
   * è·å–ç”¨æˆ·å…³æ³¨çš„æ–°é—»åˆ—è¡¨
   * @returns Promise<FollowedNewsItem[]> å…³æ³¨çš„æ–°é—»åˆ—è¡¨
