  public async getFollowedNewsList(): Promise<FollowedNewsItem[]> {
    console.log('========== è·å–å…³æ³¨æ–°é—»åˆ—è¡¨ ==========');

    try {
      // 1. è·å–è®¤è¯ token
      const token: string | null = await this.userManager.getToken();
      if (!token) {
        console.error('æœªæ‰¾åˆ°è®¤è¯ä»¤ç‰Œï¼Œè¯·å…ˆç™»å½•');
        throw new Error('è¯·å…ˆç™»å½•');
      }

      console.log('ğŸ” Tokenå‰10ä¸ªå­—ç¬¦:', token.substring(0, 10));
      console.log('ğŸ” Tokenå10ä¸ªå­—ç¬¦:', token.substring(token.length - 10));
      console.log('ğŸ” Tokenæ˜¯å¦åŒ…å«Bearer:', token.startsWith('Bearer'));
      
      // å…ˆæµ‹è¯•tokenæœ‰æ•ˆæ€§
      const isValidToken = await this.testTokenValidity();
      console.log('ğŸ§ª Tokenæœ‰æ•ˆæ€§æµ‹è¯•ç»“æœ:', isValidToken);
      
      if (!isValidToken) {
        throw new Error('Tokenæ— æ•ˆæˆ–å·²è¿‡æœŸï¼Œè¯·é‡æ–°ç™»å½•');
      }
      
      // å¦‚æœtokenå·²ç»åŒ…å«Bearerï¼Œä¸è¦é‡å¤æ·»åŠ 
      const authToken = token.startsWith('Bearer ') ? token : `Bearer ${token}`;

      // 2. æ„å»ºè¯·æ±‚å¤´
      const headers: Record<string, string> = {
        'Authorization': authToken
      };

      console.log('ğŸ” æœ€ç»ˆè¯·æ±‚å¤´ Authorization:', headers['Authorization'].substring(0, 30) + '...');

      // 3. å‘é€è¯·æ±‚
      const url: string = withBase('/api/news/followed');
      console.log('è¯·æ±‚URL:', url);

      const respText: string = await HttpUtils.get(url, headers);
      console.log('å“åº”æ•°æ®:', respText);

      // 4. è§£æå“åº”
      const resp: ResultShape<FollowedNewsItem[]> = JSON.parse(respText) as ResultShape<FollowedNewsItem[]>;

      if (resp.code === 200) {
        const data = resp.data || [];
        console.log(`è·å–å…³æ³¨åˆ—è¡¨æˆåŠŸï¼Œå…± ${data.length} æ¡`);
        return data;
      } else {
        const errorMessage: string = resp.message ?? 'è·å–å…³æ³¨åˆ—è¡¨å¤±è´¥';
        console.error('è·å–å…³æ³¨åˆ—è¡¨å¤±è´¥:', errorMessage);
        throw new Error(errorMessage);
      }
    } catch (err) {
      console.error('è·å–å…³æ³¨åˆ—è¡¨å¼‚å¸¸:', JSON.stringify(err));
      
      // é‡æ–°æŠ›å‡ºå¼‚å¸¸ï¼Œè®©è°ƒç”¨æ–¹å†³å®šå¦‚ä½•å¤„ç†
      if (err instanceof Error) {
        const errMsg: string = err.message;
        if (errMsg.includes('Network') || errMsg.includes('network')) {
          throw new Error('ç½‘ç»œè¿æ¥å¤±è´¥ï¼Œè¯·æ£€æŸ¥ç½‘ç»œè®¾ç½®');
        } else if (errMsg.includes('Timeout') || errMsg.includes('timeout')) {
          throw new Error('è¯·æ±‚è¶…æ—¶ï¼Œè¯·æ£€æŸ¥ç½‘ç»œè¿æ¥');
        } else if (errMsg.includes('403')) {
          throw new Error('æ²¡æœ‰æƒé™ï¼Œè¯·é‡æ–°ç™»å½•');
        } else if (errMsg.includes('401')) {
          throw new Error('ç™»å½•å·²è¿‡æœŸï¼Œè¯·é‡æ–°ç™»å½•');
        } else {
          throw new Error(errMsg); // é‡æ–°æŠ›å‡ºåŸå§‹å¼‚å¸¸ä¿¡æ¯
        }
      }
      
      // å¦‚æœä¸æ˜¯Errorç±»å‹ï¼Œè½¬æ¢ä¸ºError
      throw new Error('è·å–å…³æ³¨åˆ—è¡¨å¤±è´¥');
    }
  }

  /**
   * å–æ¶ˆå…³æ³¨æ–°é—»
   * @param newsUniquekey æ–°é—»å”¯ä¸€æ ‡è¯†
   * @returns Promise<boolean> æ˜¯å¦å–æ¶ˆå…³æ³¨æˆåŠŸ
   */
  public async unfollowNews(newsUniquekey: string): Promise<boolean> {
    console.log('========== å¼€å§‹å–æ¶ˆå…³æ³¨æ–°é—» ==========');
    console.log('æ–°é—»å”¯ä¸€æ ‡è¯†:', newsUniquekey);

    // 1. éªŒè¯å¿…å¡«å‚æ•°
    if (!newsUniquekey || newsUniquekey.trim() === '') {
      promptAction.showToast({ message: 'æ–°é—»å”¯ä¸€æ ‡è¯†ä¸èƒ½ä¸ºç©º' });
      return false;
    }

    try {
      // 2. è·å–è®¤è¯ token
      const token: string | null = await this.userManager.getToken();
      if (!token) {
        promptAction.showToast({ message: 'è¯·å…ˆç™»å½•' });
        console.error('æœªæ‰¾åˆ°è®¤è¯ä»¤ç‰Œï¼Œè¯·å…ˆç™»å½•');
        return false;
      }

      // 3. æ„å»ºè¯·æ±‚å¤´
      const headers: Record<string, string> = {
        'Authorization': `Bearer ${token}`
      };

      // 4. å‘é€è¯·æ±‚
      const url: string = withBase(`/api/news/unfollow?newsUniquekey=${encodeURIComponent(newsUniquekey)}`);
      console.log('è¯·æ±‚URL:', url);

      const respText: string = await HttpUtils.delete(url, headers);
      console.log('å“åº”æ•°æ®:', respText);

      // 5. è§£æå“åº”
      const resp: ResultShape<null> = JSON.parse(respText) as ResultShape<null>;

      if (resp.code === 200) {
        promptAction.showToast({ message: 'å–æ¶ˆå…³æ³¨æˆåŠŸ' });
        console.log('å–æ¶ˆå…³æ³¨æ–°é—»æˆåŠŸ');
        return true;
      } else {
        const errorMessage: string = resp.message ?? 'å–æ¶ˆå…³æ³¨å¤±è´¥';
        promptAction.showToast({ message: errorMessage });
        console.error('å–æ¶ˆå…³æ³¨æ–°é—»å¤±è´¥:', errorMessage);
        return false;
      }
    } catch (err) {
      console.error('å–æ¶ˆå…³æ³¨æ–°é—»å¼‚å¸¸:', JSON.stringify(err));
      let errorMessage: string = 'å–æ¶ˆå…³æ³¨å¤±è´¥ï¼Œè¯·ç¨åå†è¯•';

      if (err instanceof Error) {
        const errMsg: string = err.message;
        if (errMsg.includes('Network')) {
          errorMessage = 'ç½‘ç»œè¿æ¥å¤±è´¥ï¼Œè¯·æ£€æŸ¥ç½‘ç»œè®¾ç½®';
        } else if (errMsg.includes('Timeout')) {
          errorMessage = 'è¯·æ±‚è¶…æ—¶ï¼Œè¯·æ£€æŸ¥ç½‘ç»œè¿æ¥';
        } else if (errMsg.includes('403')) {
          errorMessage = 'æ²¡æœ‰æƒé™ï¼Œè¯·é‡æ–°ç™»å½•';
        } else if (errMsg.includes('401')) {
          errorMessage = 'ç™»å½•å·²è¿‡æœŸï¼Œè¯·é‡æ–°ç™»å½•';
        }
      }

      promptAction.showToast({ message: errorMessage });
      return false;
    }
  }

  /**
