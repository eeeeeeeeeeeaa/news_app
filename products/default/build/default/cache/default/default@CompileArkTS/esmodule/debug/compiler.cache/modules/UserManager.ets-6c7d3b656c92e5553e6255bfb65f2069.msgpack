    // æ›´æ–°ç”¨æˆ·ä¿¡æ¯
    async updateUserInfo(updatedUser) {
        if (!this.dataPreferences) {
            await this.initPreferences();
        }
        try {
            const allUsers = await this.getAllUsers();
            const userIndex = allUsers.findIndex((u) => u.account === updatedUser.account);
            if (userIndex !== -1) {
