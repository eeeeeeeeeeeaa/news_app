                await this.dataPreferences?.put(this.USER_KEY, JSON.stringify(allUsers));
                await this.dataPreferences?.put(this.CURRENT_USER_KEY, JSON.stringify(updatedUser));
                await this.dataPreferences?.flush();
                return true;
