export class HttpUtils {
  private static toText(result: string | Uint8Array | undefined | null): string {
    if (typeof result === 'string') {
      return result;
    }
    // æ·»åŠ äºŒè¿›åˆ¶æ•°æ®å¤„ç†é€»è¾‘ï¼ˆæ¥è‡ªç¬¬äºŒä¸ªä»£ç ï¼‰
    if (result instanceof Uint8Array) {
