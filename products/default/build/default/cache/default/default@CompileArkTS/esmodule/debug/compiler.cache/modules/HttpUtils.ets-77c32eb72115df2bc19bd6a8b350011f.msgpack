        out += String.fromCharCode(result[i]);
      }
      try {
        return decodeURIComponent(escape(out));
      } catch (_) {
        return out;
      }
    }
    return '';
  }

  // ä»¥ä¸‹ä¿æŒç¬¬ä¸€ä¸ªä»£ç çš„æ‰€æœ‰ç»“æ„å’ŒåŠŸèƒ½ä¸å˜
