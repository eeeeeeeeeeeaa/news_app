/**
 * News data entity.
 */
class NewsData {
    constructor(id, title, summary, source, publishTime, imageUrl, category, readCount, isHot = false, isTop = false, detailUrl = null) {
        this.id = id;
        this.title = title;
        this.summary = summary;
        this.source = source;
        this.publishTime = publishTime;
        this.imageUrl = imageUrl;
        this.category = category;
        this.readCount = readCount;
        this.isHot = isHot;
        this.isTop = isTop;
        this.detailUrl = detailUrl;
    }
}
