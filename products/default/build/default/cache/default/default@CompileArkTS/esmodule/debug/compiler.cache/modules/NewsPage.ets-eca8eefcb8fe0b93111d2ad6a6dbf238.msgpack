    /**
     * åŠ è½½çƒ­æœæ•°æ®
     */
    getTabKeyForCategory(category) {
        switch (category) {
            case 'è´¢ç»':
                return 'finance';
            case 'æ°‘ç”Ÿ':
                return 'livelihood';
            case 'ä½“è‚²':
                return 'sports';
            default:
                return 'realtime';
        }
    }
    async loadHotNewsData(category) {
        const targetCategory = category ?? this.currentCategory;
        this.isLoading = true;
        try {
            const tabKey = this.getTabKeyForCategory(targetCategory);
            const hotItems = await BaiduHotSearchParser.getHotSearchData(tabKey);
            const sourceLabel = targetCategory === 'çƒ­æœ' ? 'ç™¾åº¦çƒ­æœ' : `ç™¾åº¦${targetCategory}æ¦œ`;
            this.hotNewsData = hotItems.map((it, idx) => {
                const detailUrl = it.rawUrl && it.rawUrl.length > 0 ? it.rawUrl : it.linkurl;
                const imageSource = targetCategory === 'çƒ­æœ' && it.imageUrl && it.imageUrl.length > 0 ? it.imageUrl : undefined;
                return new NewsData(idx + 1, it.card_title, '', sourceLabel, '', imageSource ?? null, targetCategory, parseInt(it.heat_score || '0') || 0, true, idx < 3, detailUrl ?? null);
            });
            this.currentCategory = targetCategory;
        }
        catch (error) {
            console.error('è·å–æ¦œå•æ•°æ®å¤±è´¥:', error);
            this.hotNewsData = this.mainViewModel.getMockHotNewsData();
        }
        finally {
            this.isLoading = false;
        }
    }
    onCategorySelected(category) {
